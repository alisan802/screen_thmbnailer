<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>screen-thumbnailer third-party licenses</title>
  <style>
    body { color: #202124; font: 15px/1.5 sans-serif; margin: 0; }
    main { margin: 0 auto; max-width: 960px; padding: 24px; }
    table { border-collapse: collapse; width: 100%; }
    td, th { border-bottom: 1px solid #ddd; padding: 6px; text-align: left; }
    pre { background: #f5f5f5; max-height: 28rem; overflow: auto; padding: 12px; white-space: pre-wrap; }
    @media (prefers-color-scheme: dark) {
      body { background: #202124; color: #eee; }
      a { color: #8ab4f8; }
      pre { background: #303134; }
      td, th { border-color: #555; }
    }
  </style>
</head>
<body>
<main>
  <h1>Third-party licenses</h1>
  <p>
    This document lists Rust packages used by screen-thumbnailer for the
    supported Windows and Linux targets. It was generated from Cargo.lock with
    cargo-about. The application itself is licensed separately under the MIT
    License in LICENSE.
  </p>
  <p>
    Embedded font notices are also supplied as original text files under
    licenses/fonts/.
  </p>

  <h2>Components</h2>
  <table>
    <thead><tr><th>Component</th><th>Version</th><th>License</th></tr></thead>
    <tbody>
    {{#each crates}}
      <tr>
        <td><a href="{{#if package.repository}}{{package.repository}}{{else}}https://crates.io/crates/{{package.name}}{{/if}}">{{package.name}}</a></td>
        <td>{{package.version}}</td>
        <td>{{license}}</td>
      </tr>
    {{/each}}
    </tbody>
  </table>

  <h2>License and copyright texts</h2>
  {{#each licenses}}
    <section>
      <h3 id="{{id}}-{{@index}}">{{name}}</h3>
      <p>Used by:</p>
      <ul>
      {{#each used_by}}
        <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
      {{/each}}
      </ul>
      <pre>{{text}}</pre>
    </section>
  {{/each}}
</main>
</body>
</html>
